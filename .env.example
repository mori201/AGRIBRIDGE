# --- Supabase (obligatoire) ---
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique (publishable / anon). Protégée par les politiques RLS — ne jamais mettre la clé service_role ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# URL publique du site (liens d'e-mails, SEO, PWA)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Assistant IA (facultatif) ---
# Sans clé, l'assistant affiche clairement « non configuré ».
# AI_PROVIDER : "anthropic" ou "openai" (toute API compatible OpenAI : OpenAI, Mistral, Groq, OpenRouter...)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Uniquement pour AI_PROVIDER=openai avec une API compatible (ex. https://api.mistral.ai/v1)
AI_BASE_URL=
